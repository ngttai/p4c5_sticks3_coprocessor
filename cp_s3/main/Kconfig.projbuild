menu "StickS3 audio_fe"

    config AUDIO_FE_ENABLE
        bool "Run audio_fe (ES8311 + AFE + I2S link to the P4)"
        default y

    config AUDIO_FE_BYPASS
        bool "Bypass the AFE: send the raw mic to the link (check the I2S wiring before enabling the AFE)"
        depends on AUDIO_FE_ENABLE
        default n

    config AUDIO_FE_AMP_ALWAYS_ON
        bool "Amplifier always on (latency measurements only; avoids pops when it switches)"
        depends on AUDIO_FE_ENABLE
        default n

    config AUDIO_FE_LINK_ECHO
        bool "Link echo: return the P4 playback to the P4 (electrical link latency, not through speaker/mic)"
        depends on AUDIO_FE_ENABLE
        default n

    config AUDIO_FE_FD_HIGH
        bool "AFE_TYPE_FD + HIGH_PERF (otherwise FD LOW_COST)"
        depends on AUDIO_FE_ENABLE && !AUDIO_FE_BYPASS
        default y

endmenu
