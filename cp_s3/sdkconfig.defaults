# ── Role: COPROCESSOR ────────────────────────────────────────────────
# ESP-Hosted coprocessor firmware (works with both MCU and Linux hosts
# via the unified MCU RPC v2 wire).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

#Disable enterprise support by default
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# BT Configuration
CONFIG_BT_ENABLED=n
#CONFIG_BT_CONTROLLER_ONLY=y

# OTA
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_cp_s3.csv"

# OS
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_WIFI_NVS_ENABLED=y

CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y

# ── sticks3_coprocessor: SPI full-duplex to P4C5 (JP1) ───────────────
# Pins as in the wiring table in ../docs/WIRING.md (StickS3 Hat2 header)
CONFIG_EH_TRANSPORT_CP_SPI=y
CONFIG_EH_TRANSPORT_CP_SPI_CHECKSUM=y
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_CLK=5
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_MOSI=6
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_MISO=7
CONFIG_EH_TRANSPORT_CP_SPI_HSPI_GPIO_CS=8
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_HANDSHAKE=1
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_DATA_READY=2
# G9 (Grove): the P4 holds GPIO50 low for >= 2 ms so the S3 restarts itself (EN is not on the header)
CONFIG_EH_TRANSPORT_CP_SPI_GPIO_RESET=9

# pserial_task overflows its stack (4096) while handling the sta_connect RPC: raise the hosted task stack
CONFIG_ESP_HOSTED_DEFAULT_TASK_STACK_SIZE=6144
# sdkconfig.defaults.esp32s3 uses the old name; IDF 6.1 needs the new choice name (the default is 160 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# The StickS3 has 8 MB of flash
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# ── audio_fe (phase 5) ───────────────────────────────────────────
# Console over USB-Serial/JTAG: UART0 (G43/G44) is used for the I2S BCLK/WS of the link to the P4
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# PSRAM octal 8 MB cho AFE (AFE_MEMORY_ALLOC_MORE_PSRAM)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=n
CONFIG_AUDIO_FE_ENABLE=y
CONFIG_AUDIO_FE_FD_HIGH=y
# Per-core CPU measurement
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_AUDIO_FE_BYPASS=n
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# Allocations larger than 2 KB prefer PSRAM (default 16 KB) to keep internal RAM for WiFi/hosted/AFE
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
