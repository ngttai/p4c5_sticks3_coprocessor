CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_FREERTOS_UNICORE=n
CONFIG_FREERTOS_HZ=1000

CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n

CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23

CONFIG_IPERF_TRAFFIC_TASK_PRIORITY=23
CONFIG_IPERF_REPORT_TASK_PRIORITY=24
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# These two configurations disable the phy pll track feature, only used for experimental
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y

CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC=y
CONFIG_ESP_HOSTED_HOST_FEAT_RPC_EXT_V2=y
CONFIG_ESP_HOSTED_HOST_FEAT_SYSTEM=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
# CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ITWT is not set
# wifi-cmd has an independent ITWT CLI switch; keep it off for hosted.
# CONFIG_WIFI_CMD_ENABLE_ITWT is not set


# Co-processor = StickS3 (ESP32-S3) over full-duplex SPI on JP1 of the P4C5
CONFIG_SLAVE_IDF_TARGET_ESP32S3=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32S3=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI=y
CONFIG_ESP_HOSTED_HOST_SPI_CLK_GPIO=26
CONFIG_ESP_HOSTED_HOST_SPI_MOSI_GPIO=27
CONFIG_ESP_HOSTED_HOST_SPI_MISO_GPIO=28
CONFIG_ESP_HOSTED_HOST_SPI_CS_GPIO=29
CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO=30
CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO=45
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=50
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=26

CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32

CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

CONFIG_LWIP_TCP_SACK_OUT=y

# ── sticks3_coprocessor ──────────────────────────────────────────────
# esp-extconn was removed from main/idf_component.yml: it drives the C5 over GPIO42/43/47 + SDIO,
# while the C5 stays idle and GPIO46-49 are used for I2S
# The P4C5 has 16 MB of flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# Console over USB-Serial/JTAG (the Type-C port used for flashing) to type iperf commands
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
