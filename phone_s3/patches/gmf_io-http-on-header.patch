gmf_io 1.0.0, for the Radio app: pass the HTTP response headers to the user hook (new event HTTP_STREAM_ON_HEADER),
so that the app can read icy-metaint and Content-Type of Icecast streams. Applied at configure time by CMakeLists.txt.

--- a/esp_gmf_io_http.c
+++ b/esp_gmf_io_http.c
@@ -44,12 +44,16 @@
     return esp_http_client_read(http->client, (char *)data, size);
 }
 
+static int dispatch_hook(esp_gmf_io_handle_t self, http_stream_event_id_t type, void *buffer, int buffer_len);
+
 static esp_gmf_err_t _http_event_handle(esp_http_client_event_t *evt)
 {
     http_stream_t *http = (http_stream_t *)evt->user_data;
     if (evt->event_id != HTTP_EVENT_ON_HEADER) {
         return ESP_GMF_ERR_OK;
     }
+    /* Local patch: response headers to the user hook (ICY metadata of internet radio) */
+    dispatch_hook((esp_gmf_io_handle_t)http, HTTP_STREAM_ON_HEADER, evt, 0);
     if (strcasecmp(evt->header_key, "Content-Encoding") == 0) {
         http->gzip_encoding = true;
         if (strcasecmp(evt->header_value, "gzip") == 0) {
--- a/include/esp_gmf_io_http.h
+++ b/include/esp_gmf_io_http.h
@@ -36,6 +36,7 @@
                                       */
     HTTP_STREAM_POST_REQUEST,        /*!< The event handler will be called after HTTP Client send header and body to the server, before fetching the headers */
     HTTP_STREAM_FINISH_REQUEST,      /*!< The event handler will be called after HTTP Client fetch the header and ready to read HTTP body */
+    HTTP_STREAM_ON_HEADER,           /*!< Local patch: each response header, `buffer` is the esp_http_client_event_t (header_key, header_value) */
 } http_stream_event_id_t;
 
