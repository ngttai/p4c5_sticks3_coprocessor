CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_REV_MIN_300=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB565=y
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_400=y
CONFIG_COMPILER_DISABLE_DEFAULT_ERRORS=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
# 250 MHz was tried: PSRAM 12-20% faster (read 210, write 199 MB/s against 188, 166), but SD card writes
# then timed out (0x107) and the Camera app could not save photos; 200 MHz has no such error
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# TCP window and send buffer: the IDF default of 4 segments held Wi-Fi to 1-4 Mbps (lwIP buffers are in PSRAM)
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_ESP_BROOKESIA_ENABLE_AI_FRAMEWORK=n
CONFIG_ESP_BROOKESIA_GUI_ENABLE_ANIM_PLAYER=n
CONFIG_ESP_BROOKESIA_ENABLE_SERVICES=n
CONFIG_ESP_BROOKESIA_SYSTEMS_ENABLE_SPEAKER=n
CONFIG_BOOST_MATH_ENABLED=n
CONFIG_BOOST_SERIALIZATION_ENABLED=n
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_30=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_38=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_42=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_GRADIENT_MAX_STOPS=8

CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

CONFIG_RAINMAKER_APP_SUPPORT=n
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Wi-Fi through an ESP32-S3 (StickS3) co-processor: ESP-Hosted 3.1 over SPI full-duplex on JP1.
# The S3 runs ../cp_s3 (WiFi + AFE + I2S audio link).
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_ESP_HOSTED_CP_TARGET_FROM_WIFI_REMOTE=n
CONFIG_SLAVE_IDF_TARGET_ESP32S3=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32S3=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SPI=y
CONFIG_ESP_HOSTED_HOST_SPI_CLK_GPIO=26
CONFIG_ESP_HOSTED_HOST_SPI_MOSI_GPIO=27
CONFIG_ESP_HOSTED_HOST_SPI_MISO_GPIO=28
CONFIG_ESP_HOSTED_HOST_SPI_CS_GPIO=29
CONFIG_ESP_HOSTED_HOST_HANDSHAKE_GPIO=30
CONFIG_ESP_HOSTED_HOST_DATA_READY_GPIO=45
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=50
CONFIG_ESP_HOSTED_HOST_SPI_CLK_MHZ=26
# Hosted task stacks in PSRAM (the transport mempool stays internal for SPI DMA)
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=16
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=16

# Camera sensors on the board: SC2336 and OV2710 (auto-detected on the CSI bus)
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_OV2710=y
# Auto exposure, white balance and color correction for the Camera app
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

# Second screen app: USB device with a vendor interface (picture) and HID (touch)
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=8192
CONFIG_TINYUSB_HID_COUNT=1
# USB drive of the Files app (mass storage)
CONFIG_TINYUSB_MSC_ENABLED=y

# USB camera app: webcams have configuration descriptors of several kilobytes
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=4096
# its 4 ISOC transfers (48 KB) and descriptor lists in PSRAM: internal they took the DMA RAM the app
# needed when it was below about 70 KB (reboot on opening)
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y
# some webcams (EMEET PIXY 4K) never set the EOH bit of the UVC payload header: with the check every
# packet is dropped (no picture, and the warning flood starves CPU 1 until the task watchdog fires)
CONFIG_UVC_CHECK_PAYLOAD_HEADER_EOH=n

# Assistant app (xiaozhi.me): the clock comes from SNTP, not from the server
CONFIG_XIAOZHI_SYNC_SYSTEM_TIME_FROM_SERVER=n

# File names as UTF-8 (Vietnamese names on the microSD card)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y

# Radio app: the GMF simple player plays HLS over HTTP only, at the rate of the stream (no resampling)
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_HTTP_EN=y
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_FILE_EN=n
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_EMBED_FLASH_EN=n
CONFIG_ESP_AUDIO_SIMPLE_PLAYER_RESAMPLE_EN=n

# Wake word "Hi ESP" (WakeNet 9), model in the "model" partition
CONFIG_SR_WN_WN9_HIESP=y

# SRAM: the LVGL task uses ~8.3 KB of its stack after an hour of use (all apps)
CONFIG_BSP_DISPLAY_LVGL_TASK_STACK_SIZE=12288
# SRAM: the Assistant audio task stack (8 KB) only while it runs, not a static buffer kept for ever
CONFIG_XIAOZHI_AUDIO_TASK_ALLOC_DYNAMIC=y
